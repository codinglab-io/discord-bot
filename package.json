{
  "name": "discord-bot",
  "type": "module",
  "private": true,
  "description": "Discord bot for our server",
  "author": "Codinglab <codinglabio@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsup-node src/main.ts",
    "dev": "tsup-node src/main.ts --watch src --watch .env --watch pnpm-lock.yaml --on-success \"clear && node --enable-source-maps -r dotenv/config dist/main.js\"",
    "test": "vitest",
    "check:lint": "eslint src --report-unused-disable-directives",
    "check:format": "prettier -c src",
    "check:types": "tsc --noEmit",
    "check": "run-s check:*"
  },
  "dependencies": {
    "@keyv/redis": "2.8.5",
    "change-case": "5.4.4",
    "cheerio": "1.2.0",
    "cron": "3.5.1-beta.1",
    "discord.js": "14.27.0",
    "ioredis": "5.11.1",
    "keyv": "4.5.4",
    "nanoid": "5.0.7",
    "open-graph-scraper": "6.12.0",
    "zod": "3.26.0-canary.20250708T225111"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "7.18.1-alpha.3",
    "@typescript-eslint/parser": "7.18.1-alpha.3",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-only-error": "1.0.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sonarjs": "1.0.4",
    "eslint-plugin-unused-imports": "3.2.0",
    "npm-run-all2": "6.2.6",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "type-fest": "4.41.0",
    "typescript": "5.9.3",
    "vitest": "1.6.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.23.2"
  }
}
